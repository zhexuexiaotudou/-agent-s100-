[Unit]
Description=OpenClaw AI-NAS portal gateway on S100P
After=network-online.target qwen25-local-openai-gateway.service
Wants=network-online.target qwen25-local-openai-gateway.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/mnt/nas/openclaw
Environment=AI_NAS_PERSONAL_ROOT=/mnt/nas/openclaw/Personal
Environment=AI_NAS_REPORT_ROOT=/mnt/nas/openclaw/reports/qwen25_ai_nas
ExecStartPre=/usr/bin/test -r /mnt/nas/openclaw/scripts/probes/ai_nas_operator_portal_server.py
ExecStart=/usr/bin/python3 /mnt/nas/openclaw/scripts/probes/ai_nas_operator_portal_server.py --bind 127.0.0.1 --port 8765 --report-root /mnt/nas/openclaw/reports/qwen25_ai_nas --evidence-root /mnt/nas/openclaw/reports/qwen25_ai_nas --evidence-root /mnt/nas/openclaw/reports/ai_nas_mvp --personal-root /mnt/nas/openclaw/Personal --nas-portal --no-refresh --qwen-gateway-url http://127.0.0.1:18080 --openclaw-model-gateway-url http://127.0.0.1:18080
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
