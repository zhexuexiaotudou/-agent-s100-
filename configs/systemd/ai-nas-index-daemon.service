[Unit]
Description=AI-NAS background SQLite/FTS index daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=AI_NAS_PERSONAL_ROOT=/mnt/nas/openclaw/Personal
Environment=AI_NAS_REPORT_ROOT=/mnt/nas/openclaw/reports/ai_nas_mvp
WorkingDirectory=/root/.openclaw/workspace
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/probes/ai_nas_index_daemon.py --poll-interval-seconds 30 --max-files 50000
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
