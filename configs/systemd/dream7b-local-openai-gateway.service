[Unit]
Description=Dream7B local OpenAI-compatible gateway for OpenClaw
After=network.target dream7b-bpu-batch-queue.service

[Service]
Type=simple
Environment=DREAM7B_OPENAI_HOST=127.0.0.1
Environment=DREAM7B_OPENAI_PORT=18888
Environment=DREAM7B_OPENAI_MODEL_ID=Dream7B-S100P-local
Environment=DREAM7B_TEXT_CMD=dream7b-text
Environment=DREAM7B_OPENAI_INLINE_PERSONAL_SORT=0
Environment=DREAM7B_OPENAI_STEPS=4
Environment=DREAM7B_OPENAI_MAX_TOKENS=16
Environment=DREAM7B_OPENAI_QUICK_RESPONSE=1
Environment=DREAM7B_OPENAI_INLINE_TOKENIZER=0
Environment=DREAM7B_OPENAI_RESIDENT=1
Environment=DREAM7B_RESIDENT_CMD=/mnt/nas/openclaw/runtimes/diffuse-cpp/build/diffuse-resident
ExecStart=/mnt/nas/openclaw/runtimes/dream7b-tokenizer-venv/bin/python /root/.openclaw/workspace/scripts/dream7b_local_openai_gateway.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
