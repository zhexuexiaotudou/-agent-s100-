[Unit]
Description=Digua AI-NAS unified LAN product access
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@DIGUA_USER_DIRECTIVE@
WorkingDirectory=@DIGUA_INSTALL_ROOT@/app
EnvironmentFile=@DIGUA_ENV_FILE@
ExecStartPre=/usr/bin/test -r @DIGUA_INSTALL_ROOT@/app/src/product_access/server.py
ExecStart=@DIGUA_INSTALL_ROOT@/venv/bin/python -m src.product_access.server --bind 0.0.0.0 --port 80 --channel lan --upstream http://127.0.0.1:8765 --access-db ${DIGUA_ACCESS_DB} --identity-db ${DIGUA_IDENTITY_DB} --require-nas-mount ${DIGUA_NAS_MOUNT}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DIGUA_REPORT_ROOT@ /var/lib/digua-ai-nas
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
