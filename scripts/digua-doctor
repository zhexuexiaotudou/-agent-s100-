#!/usr/bin/env python3
import os
import sys
from pathlib import Path

SCRIPT_PATH = Path(__file__).resolve()
APP_ROOT = SCRIPT_PATH.parents[1]
PRODUCT_PYTHON = SCRIPT_PATH.parents[2] / "venv" / "bin" / "python"

if PRODUCT_PYTHON.is_file() and Path(sys.executable) != PRODUCT_PYTHON:
    os.execv(str(PRODUCT_PYTHON), [str(PRODUCT_PYTHON), str(SCRIPT_PATH), *sys.argv[1:]])

if str(APP_ROOT) not in sys.path:
    sys.path.insert(0, str(APP_ROOT))

from src.product_access.cli import main

sys.argv[1:] = ["doctor", *sys.argv[1:]]
raise SystemExit(main())
